{
  "name": "void-resume-analyzer",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "description": "AI-Powered Resume Analyzer — Void Bioluminescence",
  "scripts": {
    "dev": "concurrently -n CLIENT,SERVER -c green,magenta \"npm:dev:client\" \"npm:dev:server\"",
    "dev:client": "vite",
    "dev:server": "tsx watch server/index.ts",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "start": "node --import tsx/esm server/index.ts",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.server.json"
  },
  "dependencies": {
    "@langchain/core": "^0.2.30",
    "@langchain/openai": "^0.2.8",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "framer-motion": "^11.3.8",
    "langchain": "^0.2.16",
    "mammoth": "^1.8.0",
    "multer": "^1.4.5-lts.1",
    "openai": "^4.52.7",
    "pdf-parse": "^1.1.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.12.7",
    "zod": "^3.23.8",
    "zustand": "^4.5.4"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.14.11",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "concurrently": "^8.2.2",
    "postcss": "^8.4.39",
    "tailwindcss": "^3.4.6",
    "tsx": "^4.16.2",
    "typescript": "^5.5.3",
    "vite": "^5.3.4"
  }
}
