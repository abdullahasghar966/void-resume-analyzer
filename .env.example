# ── AI ───────────────────────────────────────────────
# Only required for Modules 2–4 (score / match / chat).
# Module 1 (parse) runs without any key.
OPENAI_API_KEY=sk-...

# ── Server ───────────────────────────────────────────
# Dedicated API port (kept separate from PORT so dev harnesses that set
# PORT=<frontend port> can't collide with Vite / break the /api proxy).
API_PORT=8787
NODE_ENV=development

# ── Limits ───────────────────────────────────────────
MAX_FILE_SIZE_MB=5
RATE_LIMIT_RPM=20

# ── CORS (comma-separated) ───────────────────────────
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
